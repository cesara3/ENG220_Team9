%% Cuba, New Mexico: Health Presentation Graphs
clear;
clc;
close all;

%% 1. Read the three CSV files
conditions = readtable('cuba_health_conditions.csv', ...
    'TextType', 'string');

risks = readtable('cuba_health_risks.csv', ...
    'TextType', 'string');

access = readtable('cuba_healthcare_access.csv', ...
    'TextType', 'string');

%% 2. Combine the conditions and risks tables
health = [conditions; risks];

%% 3. Select five indicators for Cuba
% All five use 2023 data and cover adults age 18 or older.
codes = ["BPHIGH", "OBESITY", "LPA", "DEPRESSION", "DIABETES"];

labels = {
    'High blood pressure'
    'Obesity'
    'No leisure-time activity'
    'Diagnosed depression'
    'Diagnosed diabetes'
};

values = zeros(5,1);
lower = zeros(5,1);
upper = zeros(5,1);

for k = 1:numel(codes)
    row = health(health.location == "Cuba" & ...
                 health.measure_id == codes(k), :);

    assert(height(row) == 1, ...
        'Expected one Cuba row for %s.', char(codes(k)));

    values(k) = row.percent;
    lower(k) = row.ci95_low;
    upper(k) = row.ci95_high;
end

%% 4. Graph for slide 1: Health conditions and risks
fig1 = figure('Color', 'white', ...
    'Position', [100 100 1200 700]);

bar(1:5, values, 0.65, ...
    'FaceColor', [0.10 0.42 0.60]);

hold on;

% Black lines show the 95% confidence intervals.
errorbar(1:5, values, values-lower, upper-values, ...
    'k.', 'LineWidth', 1.5, 'CapSize', 10);

% Add percentage labels above the uncertainty lines.
for k = 1:5
    text(k, upper(k)+1.5, sprintf('%.1f%%', values(k)), ...
        'HorizontalAlignment', 'center', ...
        'FontSize', 13, 'FontWeight', 'bold');
end

xticks(1:5);
xticklabels(labels);
xtickangle(15);
ylabel('Estimated percentage of adults');
ylim([0 55]);
yticks(0:10:50);

title({
    'Health Conditions and Risks in Cuba, New Mexico'
    '2023 data | CDC PLACES 2025 release'
});

set(gca, 'FontSize', 13, 'Box', 'off', ...
    'XColor', 'black', ...
    'YColor', 'black', ...
    'FontWeight', 'bold');
grid on;
set(gca, 'XGrid', 'off');
hold off;

exportgraphics(fig1, 'slide1_cuba_health.png', ...
    'Resolution', 300);

%% 5. Select preventive-care measures for three locations
locations = ["Cuba", "Bernalillo", "Rio Rancho"];
visitCodes = ["CHECKUP", "DENTAL"];

visitValues = zeros(2,3);
visitLower = zeros(2,3);
visitUpper = zeros(2,3);

for town = 1:numel(locations)
    for measure = 1:numel(visitCodes)
        row = access(access.location == locations(town) & ...
                     access.measure_id == visitCodes(measure), :);

        assert(height(row) == 1, ...
            'Expected one row for %s, %s.', ...
            char(locations(town)), char(visitCodes(measure)));

        % Use age-adjusted estimates when comparing locations.
        visitValues(measure,town) = row.age_adjusted_percent;
        visitLower(measure,town) = row.age_adjusted_ci95_low;
        visitUpper(measure,town) = row.age_adjusted_ci95_high;
    end
end

%% 6. Graph for slide 2: Preventive-care comparison
fig2 = figure('Color', 'white', ...
    'Position', [150 150 1200 700]);

b = bar(visitValues, 'grouped');

colors = [
    0.10 0.42 0.60
    0.90 0.55 0.15
    0.45 0.55 0.50
];

hold on;

for town = 1:numel(locations)
    b(town).FaceColor = colors(town,:);

    % Locate the centers of this town's bars.
    x = b(town).XEndPoints;
    y = visitValues(:,town)';

    errorbar(x, y, ...
        y-visitLower(:,town)', ...
        visitUpper(:,town)'-y, ...
        'k.', 'LineWidth', 1.3, 'CapSize', 8, ...
        'HandleVisibility', 'off');

    for measure = 1:2
        text(x(measure), visitUpper(measure,town)+1.5, ...
            sprintf('%.1f%%', y(measure)), ...
            'HorizontalAlignment', 'center', ...
            'FontSize', 12, 'FontWeight', 'bold');
    end
end

xticks(1:2);
xticklabels({
    'Routine checkup: 2023 data'
    'Dental visit: 2022 data'
});

ylabel('Age-adjusted estimated percentage of adults');
ylim([0 85]);
yticks(0:10:80);

title({
    'Preventive-Care Visits in Three New Mexico Communities'
    'Visit within the past year | CDC PLACES 2025 release'
});

legend(b, cellstr(locations), ...
    'Location', 'southoutside', ...
    'Orientation', 'horizontal');

set(gca, 'FontSize', 13, 'Box', 'off');
grid on;
set(gca, 'XGrid', 'off');
hold off;

exportgraphics(fig2, 'slide2_preventive_care.png', ...
    'Resolution', 300);

%% 7. Confirm the images were saved
disp('Created slide1_cuba_health.png');
disp('Created slide2_preventive_care.png');